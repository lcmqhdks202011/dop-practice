<?xml version="1.0" encoding="utf-8"?>
<!--
  관리 서버 설치 파일 (MSI). build.ps1 로 만듭니다.
  자바 실행 환경(runtime 폴더)을 같이 넣으므로 서버 PC에 자바를 따로 설치하지 않아도 됩니다.
  예전 설치 스크립트와 같은 C:\UsbControlServer 에 설치하므로 데이터(data, backup 폴더)를 그대로 이어 씁니다.
  제거해도 data, backup, logs 폴더는 남습니다.
  포트 바꾸기: msiexec /i UsbControlServer-x.y.z.msi PORT=9090
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="USB 매체제어 관리 서버" Manufacturer="USB 매체제어" Version="$(var.Version)"
           UpgradeCode="0D7E5B2C-91A4-4E6F-B3D8-5C2A1F9E7B40" Language="1042" Codepage="949" Scope="perMachine">
    <SummaryInformation Description="USB 매체제어 관리 서버" Codepage="949" />
    <MajorUpgrade DowngradeErrorMessage="더 새 버전이 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="PORT" Value="8080" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- 서버는 창이 없는 시스템 계정으로 돌므로 '사용 중인 파일' 확인 창 대신 설치 전에 서버를 멈춥니다. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Sequence="ui" Before="ExecuteAction"
              Value="브라우저로 http://localhost:[PORT] 에 들어가 첫 관리자 계정을 만드세요. (시작 메뉴 'USB 매체제어 관리 화면')&#13;&#10;다른 PC에서는 http://이PC주소:[PORT] 로 들어옵니다. 네트워크가 '공용'이면 접속이 안 되니 '개인'으로 바꾸세요." />

    <!-- 윈도우가 설치된 드라이브(보통 C:)의 UsbControlServer. 아래 SetDirectory 가 위치를 바꿉니다.
         (Program Files 아래로 적어 두는 것은 WiX가 구성 요소 ID를 만들 때 쓰는 이름일 뿐입니다) -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UsbControlServer">
        <Directory Id="RUNTIMEFOLDER" Name="runtime" />
      </Directory>
    </StandardDirectory>
    <SetDirectory Id="INSTALLFOLDER" Value="[WindowsVolume]UsbControlServer" Sequence="both" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ServerFiles" Directory="INSTALLFOLDER">
      <Component><File Source="$(var.JarPath)" /></Component>
      <Component><File Source="$(var.ScriptDir)\install-server.ps1" /></Component>
      <Component><File Source="$(var.ScriptDir)\uninstall-server.ps1" /></Component>
      <Files Include="$(var.RuntimeDir)\**" Directory="RUNTIMEFOLDER" />
      <Component Id="AdminShortcut" Directory="ProgramMenuFolder">
        <util:InternetShortcut Id="AdminPage" Name="USB 매체제어 관리 화면" Target="http://localhost:[PORT]" />
        <RegistryValue Root="HKLM" Key="Software\UsbControlServer" Name="Port" Type="string" Value="[PORT]" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="ServerFiles" />
    </Feature>

    <!-- 파일을 덮어쓰기 전에 돌고 있는 서버를 멈춥니다 (예전 스크립트로 설치한 서버 포함). -->
    <SetProperty Id="StopServer" Sequence="execute" Before="StopServer" Condition="NOT REMOVE"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;if (Get-ScheduledTask -TaskName UsbControlServer -ErrorAction SilentlyContinue) { Stop-ScheduledTask -TaskName UsbControlServer; Start-Sleep -Seconds 3 }&quot;" />
    <CustomAction Id="StopServer" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- 설치: 폴더 잠금, 자동 실행, 방화벽 포트, 시작 (install-server.ps1) -->
    <SetProperty Id="RunInstall" Sequence="execute" Before="RunInstall" Condition="NOT REMOVE"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install-server.ps1&quot; -InPlace -Quiet -Port [PORT]" />
    <CustomAction Id="RunInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- 제거 (새 버전으로 올릴 때도): 서버를 멈추고 자동 실행과 방화벽 규칙을 지웁니다. 새 버전 설치가 다시 등록합니다. -->
    <SetProperty Id="RunUninstall" Sequence="execute" Before="RunUninstall" Condition="REMOVE=&quot;ALL&quot;"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]uninstall-server.ps1&quot;" />
    <CustomAction Id="RunUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopServer" Before="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RunInstall" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RunUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <UI Id="ServerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
